.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Docker files themselves
Dockerfile*
docker-compose*.yml
compose*.yml
.dockerignore

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and temp files
*.log
tmp/
